---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

const year = new Date().getFullYear();
---

<Base>
  <nav class="wrap nav">
    <a href="/" class="logo">{profile.name}</a>
    <div class="nav-links">
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <button id="theme-toggle" class="icon-btn" aria-label="Toggle dark mode">◐</button>
    </div>
  </nav>

  <main>
    <section class="wrap hero">
      <p class="eyebrow">{profile.role}</p>
      <h1>Hi, I'm {profile.name.split(" ")[0]}.</h1>
      <p class="lead">{profile.tagline}</p>
      <div class="cta">
        <a href="#projects" class="btn">See my work</a>
        {profile.links.github && <a href={profile.links.github} class="btn ghost">GitHub</a>}
        {profile.links.resume && <a href={profile.links.resume} class="btn ghost">Résumé</a>}
      </div>
    </section>

    <section id="projects" class="wrap">
      <h2>Projects</h2>
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    <section id="about" class="wrap">
      <h2>About</h2>
      <p>
        I enjoy owning a project from database schema to deployment. Every site listed here runs on
        my own infrastructure: a Proxmox cluster running k3s, fronted by Cloudflare.
      </p>
      <ul class="skills">
        {profile.skills.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section id="contact" class="wrap">
      <h2>Contact</h2>
      <p>Open to opportunities and collaborations.</p>
      <div class="cta">
        {profile.email && <a href={`mailto:${profile.email}`} class="btn">Email me</a>}
        {profile.links.linkedin && <a href={profile.links.linkedin} class="btn ghost">LinkedIn</a>}
        {profile.links.github && <a href={profile.links.github} class="btn ghost">GitHub</a>}
      </div>
    </section>
  </main>

  <footer class="wrap site-footer">
    <p>© {year} {profile.name}</p>
  </footer>

  <script>
    const btn = document.getElementById("theme-toggle");
    btn?.addEventListener("click", () => {
      const root = document.documentElement;
      const current =
        root.dataset.theme ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      const next = current === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
    });
  </script>
</Base>
